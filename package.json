{
  "name": "guardias",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning scripts/build-server.mjs && PORT=3002 DATA_DIR=.data node --watch --watch-path=server --watch-path=src/data.ts server/index.mjs",
    "build": "tsc --noEmit && vite build && node scripts/precompress.mjs && node --disable-warning=ExperimentalWarning scripts/build-server.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "holidays": "node scripts/build-holidays.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "6.1.21",
    "date-fns": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.47",
    "date-holidays": "^3.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
